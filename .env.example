# Creator Foundry — Environment Configuration
# Copy this to .env.local and fill in your values.
# Everything here is OPTIONAL: with no .env.local at all the app still boots,
# serves every route, and reports simulated (never fake-hash) on-chain actions.

# === CHAIN (Arbitrum Open House Buildathon) ===
# arbitrum-sepolia   (chain id 421614)      — the hackathon's home chain
# robinhood-testnet  (chain id 46630, an Arbitrum Orbit chain)
# Both chains have all three contracts deployed; see deployments.json.
#
# NOTE: the demo transactions cited in README.md / docs/DEMO.md were executed on
# robinhood-testnet. Set this to robinhood-testnet to reproduce those links;
# arbitrum-sepolia is the buildathon's home chain and is the default here.
NEXT_PUBLIC_CHAIN=arbitrum-sepolia

# === ON-CHAIN CONTRACTS ===
# Addresses are PER CHAIN and normally live in deployments.json — the registry
# written by scripts/deploy.mjs and resolved for the chain above by
# src/lib/chains.ts. Set the vars below only to override/point at a deployment
# the registry doesn't know about (e.g. a manual Remix deploy).
#
#   node scripts/deploy.mjs arbitrum-sepolia   (or robinhood-testnet)
#
# Deploying a chain rewrites .env.local only when it is the active chain here,
# so deploying a second chain cannot repoint a working app.
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_SPLITS_CONTRACT_ADDRESS=
# Bounty escrow — locks bounty rewards BEFORE the work starts, releases them on
# producer approval or automatically when the review window expires.
# When the active chain has none, payouts fall back to a direct transfer.
NEXT_PUBLIC_BOUNTY_ESCROW_ADDRESS=

# === SERVER SIGNER (optional — demo mode if unset) ===
# Backend wallet for server-side transactions. NEVER expose to the client.
# FORGE_PRIVATE_KEY=
# Platform fee wallet (3% of sales; defaults to a placeholder if unset).
# FORGE_FEE_WALLET=

# === Paxos USDG (preconfigured — no action needed) ===
# Arbitrum Sepolia:     0xFFC95faa3d63Cde504a05B567C600B78C0b41892
# Robinhood Testnet:    0x7E955252E15c84f5768B83c41a71F9eba181802F
# Arbitrum One mainnet: 0x004B506865409877C9fA29bfb1ebA929984B9bbC

# === AI (optional — project-derived local fallback if unset) ===
# Any OpenAI-compatible endpoint works (Groq, Together, OpenRouter, OpenAI).
# FOUNDRY_AI_BASE_URL=https://api.groq.com/openai/v1
# FOUNDRY_AI_KEY=
# FOUNDRY_AI_MODEL=openai/gpt-oss-120b

# === Trained critic service (optional — see services/critic/README.md) ===
# CRITIC_SERVICE_URL=http://localhost:8787
# Origin the critic service uses to resolve app-relative asset URLs (/api/files/...)
# APP_ORIGIN=http://localhost:3000

# === DATABASE — Supabase (optional — local JSON store if unset) ===
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# === WalletConnect (optional) ===
# NEXT_PUBLIC_WALLETCONNECT_ID=
